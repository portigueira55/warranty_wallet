{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "prebuildCommand": "echo 'Skipping prebuild - using committed android code'"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "prebuildCommand": "echo 'Skipping prebuild - using committed android code'"
      },
      "distribution": "internal"
    },
    "apk": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "prebuildCommand": "echo 'Skipping prebuild - using committed android code'"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "prebuildCommand": "echo 'Skipping prebuild - using committed android code'"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
