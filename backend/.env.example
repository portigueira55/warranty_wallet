# Servidor
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Railway lo provee automáticamente)
# Railway inyecta DATABASE_URL automáticamente cuando agregas PostgreSQL
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/warranty_wallet

# Uploads
UPLOAD_DIR=/app/uploads
