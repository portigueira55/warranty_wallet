# Database
DATABASE_URL="postgresql://user:password@localhost:5432/warranty_wallet"

# JWT
JWT_SECRET="tu-secret-super-secreto-cambialo"
JWT_REFRESH_SECRET="otro-secret-super-secreto-cambialo"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:19006"

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR="./uploads"

# Email (opcional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@warrantywallet.com"

# AWS S3 (opcional, para producción)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="eu-west-1"
